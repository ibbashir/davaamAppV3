# Firebase project config (Project settings > General > Your apps > SDK setup and configuration)
# Copy this file to .env and fill in your project's values. Used for uploading
# outreach event gallery images directly to Firebase Storage from the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
